# =============================================================================
# Room Booking Frontend - Environment Configuration
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# API Base URL (Laravel API root, typically ending with /api)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Authentication mode: "sanctum" (cookie-based) or "bearer" (token-based)
VITE_API_AUTH_MODE=sanctum

# Use mock data instead of real API (true/false)
# Set to false when connecting to your Laravel backend
VITE_USE_MOCK_DATA=true

# Optional: App name shown in UI
VITE_APP_NAME=RoomBook

# Optional: Default language (en | ar)
VITE_DEFAULT_LANGUAGE=en

# Optional: Default theme (light | dark | system)
VITE_DEFAULT_THEME=system
